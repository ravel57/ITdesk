{
  "version": 3,
  "entryNodeId": "duplicates-1",
  "nodes": [
    {
      "id": "duplicates-1",
      "type": "EVENT",
      "label": "Когда запускать",
      "x": 80,
      "y": 100,
      "config": {
        "section": "1. Настройки",
        "triggerType": "TASK_CREATED"
      }
    },
    {
      "id": "duplicates-2",
      "type": "PARAMETERS",
      "label": "Настройки сценария",
      "x": 500,
      "y": 100,
      "config": {
        "section": "1. Настройки",
        "resultVariable": "settings",
        "parameters": [
          {
            "name": "threshold",
            "label": "Минимальная уверенность Jev",
            "value": 0.6,
            "help": "Ниже порога данные не меняются.",
            "type": "number",
            "migrationSetting": "findDuplicate",
            "min": 0,
            "max": 1
          },
          {
            "name": "hours",
            "label": "Окно поиска открытых заявок, часов",
            "value": 72,
            "help": "",
            "type": "number",
            "min": 1,
            "max": 8760
          },
          {
            "name": "candidates",
            "label": "Максимум кандидатов",
            "value": 30,
            "help": "",
            "type": "number",
            "min": 1,
            "max": 100
          }
        ],
        "description": "Начните с этого блока: здесь меняются пороги, интервалы и ограничения. Остальные шаги используют эти значения."
      }
    },
    {
      "id": "duplicates-5",
      "type": "OPERATION",
      "label": "Проверить связь текущей заявки",
      "x": 80,
      "y": 570,
      "config": {
        "section": "2. Кандидаты из активных инцидентов",
        "operation": "data.links",
        "arguments": {
          "taskId": "=task.id"
        },
        "resultVariable": "currentLinks"
      }
    },
    {
      "id": "duplicates-6",
      "type": "CONDITION",
      "label": "Текущая заявка ещё не связана с инцидентом?",
      "x": 500,
      "y": 570,
      "config": {
        "section": "2. Кандидаты из активных инцидентов",
        "expression": "var.currentLinks.isEmpty()",
        "manualExpression": true,
        "groups": [],
        "rule": {
          "left": "=var.currentLinks",
          "operator": "empty"
        }
      }
    },
    {
      "id": "duplicates-7",
      "type": "OPERATION",
      "label": "Заявки активных инцидентов",
      "x": 920,
      "y": 570,
      "config": {
        "section": "2. Кандидаты из активных инцидентов",
        "operation": "data.links",
        "arguments": {
          "limit": 1000
        },
        "resultVariable": "allLinks"
      }
    },
    {
      "id": "duplicates-8",
      "type": "OPERATION",
      "label": "Отобрать: activeLinks",
      "x": 1340,
      "y": 570,
      "config": {
        "section": "2. Кандидаты из активных инцидентов",
        "operation": "list.select",
        "arguments": {
          "items": "=var.allLinks",
          "where": "!(var.item.incident.status in ['CLOSED', 'CANCELLED'])",
          "sortBy": "incident.id",
          "descending": false,
          "limit": 1000
        },
        "resultVariable": "activeLinks"
      }
    },
    {
      "id": "duplicates-9",
      "type": "OPERATION",
      "label": "Кандидаты из инцидентов",
      "x": 1760,
      "y": 570,
      "config": {
        "section": "2. Кандидаты из активных инцидентов",
        "operation": "list.project",
        "arguments": {
          "items": "=var.activeLinks",
          "expression": "var.item.task"
        },
        "resultVariable": "incidentTasks"
      }
    },
    {
      "id": "duplicates-10",
      "type": "OPERATION",
      "label": "Свежие открытые заявки",
      "x": 80,
      "y": 1290,
      "config": {
        "section": "3. Дополнить свежими открытыми заявками",
        "operation": "data.tasks",
        "arguments": {
          "hours": "=var.settings.hours",
          "limit": "=var.settings.candidates"
        },
        "resultVariable": "recentTasks"
      }
    },
    {
      "id": "duplicates-11",
      "type": "OPERATION",
      "label": "Сначала заявки инцидентов, затем остальные",
      "x": 500,
      "y": 1290,
      "config": {
        "section": "3. Дополнить свежими открытыми заявками",
        "operation": "list.concat",
        "arguments": {
          "first": "=var.incidentTasks",
          "second": "=var.recentTasks"
        },
        "resultVariable": "allCandidates"
      }
    },
    {
      "id": "duplicates-12",
      "type": "OPERATION",
      "label": "Исключить текущую и повторяющихся кандидатов",
      "x": 920,
      "y": 1290,
      "config": {
        "section": "3. Дополнить свежими открытыми заявками",
        "operation": "list.select",
        "arguments": {
          "items": "=var.allCandidates",
          "where": "var.item.id != task.id",
          "sortBy": "",
          "distinctBy": "id",
          "limit": "=var.settings.candidates"
        },
        "resultVariable": "candidates"
      }
    },
    {
      "id": "duplicates-13",
      "type": "OPERATION",
      "label": "Есть ли дубль среди кандидатов?",
      "x": 80,
      "y": 1760,
      "config": {
        "section": "4. Получить оценку и выбрать явное действие",
        "operation": "ai.decide",
        "arguments": {
          "state": {
            "name": "=task.name",
            "description": "=task.description"
          },
          "question": "Описывает ли новая заявка ту же проблему, что одна из этих заявок?",
          "kind": "choice",
          "options": {
            "__none__": "Это отдельная проблема"
          },
          "yes": "Да",
          "no": "Нет",
          "candidates": "=var.candidates",
          "labelExpression": "var.item.name + ': ' + var.item.description.truncate(500)"
        },
        "resultVariable": "decision"
      }
    },
    {
      "id": "duplicates-14",
      "type": "CONDITION",
      "label": "Ответ получен и уверенности достаточно?",
      "x": 500,
      "y": 1760,
      "config": {
        "section": "4. Получить оценку и выбрать явное действие",
        "expression": "var.decision.available && var.decision.probability >= var.settings.threshold && var.decision.value.notNull()",
        "manualExpression": true,
        "groups": [],
        "rule": {
          "all": [
            {
              "left": "=var.decision.available",
              "operator": "true"
            },
            {
              "left": "=var.decision.probability",
              "operator": ">=",
              "right": "=var.settings.threshold"
            },
            {
              "left": "=var.decision.value",
              "operator": "notNull"
            }
          ]
        }
      }
    },
    {
      "id": "duplicates-15",
      "type": "CONDITION",
      "label": "Дубль относится к активному инциденту?",
      "x": 920,
      "y": 1760,
      "config": {
        "section": "4. Получить оценку и выбрать явное действие",
        "expression": "var.decision.value.incident.notNull() && !(var.decision.value.incident.status in ['CLOSED','CANCELLED'])",
        "manualExpression": true,
        "groups": [],
        "rule": {
          "all": [
            {
              "left": "=var.decision.value.incident",
              "operator": "notNull"
            },
            {
              "not": {
                "left": "=var.decision.value.incident.status",
                "operator": "in",
                "right": "=['CLOSED','CANCELLED']"
              }
            }
          ]
        }
      }
    },
    {
      "id": "duplicates-16",
      "type": "OPERATION",
      "label": "Привязать новую заявку к инциденту",
      "x": 1340,
      "y": 1760,
      "config": {
        "section": "4. Получить оценку и выбрать явное действие",
        "operation": "incident.linkTasks",
        "arguments": {
          "incidentId": "=var.decision.value.incident.id",
          "taskIds": [
            "=task.id"
          ]
        },
        "resultVariable": ""
      }
    },
    {
      "id": "duplicates-17",
      "type": "OPERATION",
      "label": "Записать связь в инцидент",
      "x": 1760,
      "y": 1760,
      "config": {
        "section": "4. Получить оценку и выбрать явное действие",
        "operation": "incident.note",
        "arguments": {
          "incidentId": "=var.decision.value.incident.id",
          "text": "Заявка #{{ task.id }} — дубль заявки #{{ var.decision.value.id }} (Jev)"
        },
        "resultVariable": ""
      }
    },
    {
      "id": "duplicates-18",
      "type": "OPERATION",
      "label": "Сообщить оператору о привязке",
      "x": 2180,
      "y": 1760,
      "config": {
        "section": "4. Получить оценку и выбрать явное действие",
        "operation": "client.note",
        "arguments": {
          "clientId": "=client.id",
          "text": "Jev: заявка #{{ task.id }} — дубль заявки #{{ var.decision.value.id }}, привязана к инциденту {{ var.decision.value.incident.number }}."
        },
        "resultVariable": ""
      }
    },
    {
      "id": "duplicates-19",
      "type": "CONDITION",
      "label": "Это заявка того же клиента?",
      "x": 1340,
      "y": 2010,
      "config": {
        "section": "4. Получить оценку и выбрать явное действие",
        "expression": "var.decision.value.clientId = client.id",
        "manualExpression": true,
        "groups": [],
        "rule": {
          "left": "=var.decision.value.clientId",
          "operator": "=",
          "right": "=client.id"
        }
      }
    },
    {
      "id": "duplicates-20",
      "type": "OPERATION",
      "label": "Подсказать объединение заявок",
      "x": 1760,
      "y": 2010,
      "config": {
        "section": "4. Получить оценку и выбрать явное действие",
        "operation": "client.note",
        "arguments": {
          "clientId": "=client.id",
          "text": "Jev: заявка #{{ task.id }} похожа на открытую заявку #{{ var.decision.value.id }} этого же клиента. Возможно, заявки стоит объединить."
        },
        "resultVariable": ""
      }
    },
    {
      "id": "duplicates-21",
      "type": "OPERATION",
      "label": "Подсказать возможный массовый инцидент",
      "x": 1760,
      "y": 2260,
      "config": {
        "section": "4. Получить оценку и выбрать явное действие",
        "operation": "client.note",
        "arguments": {
          "clientId": "=client.id",
          "text": "Jev: заявка #{{ task.id }} похожа на открытую заявку #{{ var.decision.value.id }} другого клиента. Проверьте, не массовый ли это сбой."
        },
        "resultVariable": ""
      }
    },
    {
      "id": "duplicates-22",
      "type": "END",
      "label": "Ошибка — посмотреть журнал",
      "x": 2180,
      "y": 570,
      "config": {
        "section": "2. Кандидаты из активных инцидентов",
        "result": "Шаг не выполнен. Причина указана в журнале."
      }
    },
    {
      "id": "duplicates-23",
      "type": "END",
      "label": "На этом закончить",
      "x": 920,
      "y": 820,
      "config": {
        "section": "2. Кандидаты из активных инцидентов",
        "result": "Дополнительные действия не требуются"
      }
    },
    {
      "id": "duplicates-24",
      "type": "END",
      "label": "Ошибка — посмотреть журнал",
      "x": 1340,
      "y": 1290,
      "config": {
        "section": "3. Дополнить свежими открытыми заявками",
        "result": "Шаг не выполнен. Причина указана в журнале."
      }
    },
    {
      "id": "duplicates-25",
      "type": "END",
      "label": "Ошибка — посмотреть журнал",
      "x": 2600,
      "y": 1760,
      "config": {
        "section": "4. Получить оценку и выбрать явное действие",
        "result": "Шаг не выполнен. Причина указана в журнале."
      }
    },
    {
      "id": "duplicates-26",
      "type": "END",
      "label": "На этом закончить",
      "x": 2600,
      "y": 2010,
      "config": {
        "section": "4. Получить оценку и выбрать явное действие",
        "result": "Дополнительные действия не требуются"
      }
    }
  ],
