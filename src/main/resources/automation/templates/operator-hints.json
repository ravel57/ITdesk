{
  "version": 3,
  "entryNodeId": "hint-1",
  "nodes": [
    {
      "id": "hint-1",
      "type": "EVENT",
      "label": "Когда запускать",
      "x": 80.0,
      "y": 100.0,
      "config": {
        "section": "1. Настройки",
        "triggerType": "MESSAGE_INCOMING"
      }
    },
    {
      "id": "hint-2",
      "type": "PARAMETERS",
      "label": "Настройки сценария",
      "x": 500.0,
      "y": 100.0,
      "config": {
        "section": "1. Настройки",
        "description": "Одна подсказка оператору на сообщение клиента: кандидаты из базы знаний, закрытых заявок и истории чатов сравниваются в одном выборе Jev. Здесь включаются источники, задаются пороги и ограничения. Оценки подсказок операторами — в журнале этого правила.",
        "resultVariable": "settings",
        "parameters": [
          {
            "name": "threshold",
            "label": "Минимальная уверенность Jev",
            "type": "number",
            "value": 0.7,
            "min": 0,
            "max": 1,
            "help": "Ниже порога подсказка не публикуется."
          },
          {
            "name": "cooldownMinutes",
            "label": "Не чаще одной подсказки клиенту раз в N минут",
            "type": "number",
            "value": 5,
            "min": 0,
            "max": 1440,
            "help": "0 — без ограничения. Серия сообщений клиента не превращается в серию комментариев."
          },
          {
            "name": "useArticles",
            "label": "Источник: статьи базы знаний",
            "type": "boolean",
            "value": true,
            "help": ""
          },
          {
            "name": "articles",
            "label": "Максимум статей для выбора",
            "type": "number",
            "value": 100,
            "min": 1,
            "max": 1000,
            "help": ""
          },
          {
            "name": "excerpt",
            "label": "Символов описания статьи",
            "type": "number",
            "value": 200,
            "min": 1,
            "max": 3000,
            "help": ""
          },
          {
            "name": "useTasks",
            "label": "Источник: закрытые заявки",
            "type": "boolean",
            "value": true,
            "help": ""
          },
          {
            "name": "tasks",
            "label": "Максимум закрытых заявок для выбора",
            "type": "number",
            "value": 10,
            "min": 1,
            "max": 30,
            "help": ""
          },
          {
            "name": "messages",
            "label": "Максимум реплик переписки заявки",
            "type": "number",
            "value": 40,
            "min": 2,
            "max": 300,
            "help": ""
          },
          {
            "name": "useReplies",
            "label": "Источник: история чатов",
            "type": "boolean",
            "value": true,
            "help": ""
          },
          {
            "name": "replies",
            "label": "Максимум пар «вопрос — ответ» для выбора",
            "type": "number",
            "value": 10,
            "min": 1,
            "max": 30,
            "help": ""
          },
          {
            "name": "minAnswer",
            "label": "Минимальная длина ответа оператора",
            "type": "number",
            "value": 40,
            "min": 1,
            "max": 1000,
            "help": "Короткие реплики («Пришлите скриншот») пропускаются."
          },
          {
            "name": "days",
            "label": "Искать в заявках и чатах за последние дни",
            "type": "number",
            "value": 365,
            "min": 1,
            "max": 3650,
            "help": ""
          },
          {
            "name": "sameOrganization",
            "label": "Заявки и чаты только той же организации",
            "type": "boolean",
            "value": false,
            "help": "Если выключено — ищется переписка всех клиентов; ИИ не пишет в подсказке имён, контактов и названий организаций."
          }
        ]
      }
    },
    {
      "id": "hint-source",
      "type": "OPERATION",
      "label": "Сохранить сообщение, запустившее подсказку",
      "x": 80.0,
      "y": 570.0,
      "config": {
        "section": "2. Сообщение клиента",
        "operation": "value.set",
        "arguments": {
          "value": {
            "id": "=message.id",
            "text": "=message.text",
            "clientId": "=client.id",
            "organizationId": "=client.organization.id"
          }
        },
        "resultVariable": "sourceMessage",
        "description": "Фиксируем ID и текст события: дальше все шаги работают с ним."
      }
    },
    {
      "id": "hint-incoming",
      "type": "CONDITION",
      "label": "Входящее сообщение содержит текст?",
      "x": 500.0,
      "y": 570.0,
      "config": {
        "section": "2. Сообщение клиента",
        "rule": {
          "all": [
            {
              "left": "=var.sourceMessage.id",
              "operator": "notNull"
            },
            {
              "left": "=var.sourceMessage.text",
              "operator": "notEmpty"
            },
            {
              "not": {
                "left": "=message.isSent",
                "operator": "true"
              }
            },
            {
              "not": {
                "left": "=message.isComment",
                "operator": "true"
              }
            },
            {
              "not": {
                "left": "=message.deleted",
                "operator": "true"
              }
            }
          ]
        },
        "groups": [],
        "expression": "var.sourceMessage.id.notNull() && var.sourceMessage.text.notEmpty() && !message.isSent && !message.isComment && !message.deleted",
        "manualExpression": true
      }
    },
    {
      "id": "hint-end-2",
      "type": "END",
      "label": "На этом закончить",
      "x": 920.0,
      "y": 750.0,
      "config": {
        "section": "2. Сообщение клиента",
        "result": "Дополнительные действия не требуются"
      }
    },
    {
      "id": "hint-error-2",
      "type": "END",
      "label": "Ошибка — посмотреть журнал",
      "x": 1340.0,
      "y": 750.0,
      "config": {
        "section": "2. Сообщение клиента",
        "result": "Шаг не выполнен. Причина указана в журнале."
      }
    },
    {
      "id": "hint-latest-selection",
      "type": "OPERATION",
      "label": "Загрузить входящие сообщения клиента",
      "x": 920.0,
      "y": 570.0,
      "config": {
        "section": "2. Сообщение клиента",
        "operation": "data.messages",
        "arguments": {
          "limit": 1000,
          "clientId": "=var.sourceMessage.clientId",
          "incomingOnly": true,
          "newestFirstById": true
        },
        "resultVariable": "latestMessages"
      }
    },
    {
      "id": "hint-filter-selection",
      "type": "OPERATION",
      "label": "Отобрать: latestIncoming",
      "x": 1340.0,
      "y": 570.0,
      "config": {
        "section": "2. Сообщение клиента",
        "operation": "list.select",
        "arguments": {
          "items": "=var.latestMessages",
          "limit": 1,
          "where": "!var.item.sent && !var.item.comment && !var.item.system && !var.item.deleted",
          "sortBy": "id",
          "descending": true
        },
        "resultVariable": "latestIncoming"
      }
    },
    {
      "id": "hint-current-selection",
      "type": "CONDITION",
      "label": "Это всё ещё последнее сообщение?",
      "x": 1760.0,
      "y": 570.0,
      "config": {
        "section": "2. Сообщение клиента",
        "rule": {
          "left": "=var.latestIncoming.first().id",
          "right": "=var.sourceMessage.id",
          "operator": "="
        },
        "groups": [],
        "expression": "var.latestIncoming.first().id = var.sourceMessage.id",
        "manualExpression": true
      }
    },
    {
      "id": "hint-cooldown-check",
      "type": "OPERATION",
      "label": "Подсказка клиенту давно не публиковалась?",
      "x": 2180.0,
      "y": 570.0,
      "config": {
        "section": "2. Сообщение клиента",
        "operation": "state.cooldown",
        "arguments": {
          "key": "hint-cooldown:client:{{ var.sourceMessage.clientId }}",
          "minutes": "=var.settings.cooldownMinutes",
          "consume": false
        },
        "resultVariable": "cooldownCheck",
        "description": "Только проверка, ключ не занимается: до дорогих шагов отсеиваем серию сообщений подряд."
      }
    },
    {
      "id": "hint-cooldown-free",
      "type": "CONDITION",
      "label": "Интервал между подсказками прошёл?",
      "x": 2600.0,
      "y": 570.0,
      "config": {
        "section": "2. Сообщение клиента",
        "rule": {
          "left": "=var.cooldownCheck.acquired",
          "operator": "true"
        },
        "groups": [],
        "expression": "var.cooldownCheck.acquired",
        "manualExpression": true
      }
    },
    {
      "id": "hint-use-articles",
      "type": "CONDITION",
      "label": "Статьи базы знаний включены?",
      "x": 80.0,
      "y": 1040.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "rule": {
          "left": "=var.settings.useArticles",
          "operator": "true"
        },
        "groups": [],
        "expression": "var.settings.useArticles",
        "manualExpression": true
      }
    },
    {
      "id": "hint-articles-off",
      "type": "OPERATION",
      "label": "Источник выключен — нет статей",
      "x": 80.0,
      "y": 1220.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "operation": "value.set",
        "arguments": {
          "value": []
        },
        "resultVariable": "articleCandidates"
      }
    },
    {
      "id": "hint-articles",
      "type": "OPERATION",
      "label": "Загрузить статьи базы знаний",
      "x": 500.0,
      "y": 1040.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "operation": "data.articles",
        "arguments": {
          "limit": "=var.settings.articles"
        },
        "resultVariable": "articles"
      }
    },
    {
      "id": "hint-articles-candidates",
      "type": "OPERATION",
      "label": "Варианты: статьи",
      "x": 920.0,
      "y": 1040.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "operation": "list.candidates",
        "arguments": {
          "items": "=var.articles",
          "kind": "article",
          "label": "'Статья базы знаний «' + var.item.name + '»: ' + var.item.text.truncate(var.settings.excerpt)"
        },
        "resultVariable": "articleCandidates"
      }
    },
    {
      "id": "hint-use-tasks",
      "type": "CONDITION",
      "label": "Закрытые заявки включены?",
      "x": 1340.0,
      "y": 1040.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "rule": {
          "left": "=var.settings.useTasks",
          "operator": "true"
        },
        "groups": [],
        "expression": "var.settings.useTasks",
        "manualExpression": true
      }
    },
    {
      "id": "hint-tasks-off",
      "type": "OPERATION",
      "label": "Источник выключен — нет заявок",
      "x": 1340.0,
      "y": 1220.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "operation": "value.set",
        "arguments": {
          "value": []
        },
        "resultVariable": "taskCandidates"
      }
    },
    {
      "id": "hint-tasks",
      "type": "OPERATION",
      "label": "Найти похожие закрытые заявки",
      "x": 1760.0,
      "y": 1040.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "operation": "data.similarTasks",
        "arguments": {
          "text": "=var.sourceMessage.text",
          "days": "=var.settings.days",
          "sameOrganizationOnly": "=var.settings.sameOrganization",
          "organizationId": "=var.sourceMessage.organizationId",
          "limit": "=var.settings.tasks"
        },
        "resultVariable": "similarTasks"
      }
    },
    {
      "id": "hint-tasks-candidates",
      "type": "OPERATION",
      "label": "Варианты: закрытые заявки",
      "x": 2180.0,
      "y": 1040.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "operation": "list.candidates",
        "arguments": {
          "items": "=var.similarTasks",
          "kind": "task",
          "label": "'Закрытая заявка: ' + var.item.summary"
        },
        "resultVariable": "taskCandidates"
      }
    },
    {
      "id": "hint-use-replies",
      "type": "CONDITION",
      "label": "История чатов включена?",
      "x": 80.0,
      "y": 1400.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "rule": {
          "left": "=var.settings.useReplies",
          "operator": "true"
        },
        "groups": [],
        "expression": "var.settings.useReplies",
        "manualExpression": true
      }
    },
    {
      "id": "hint-replies-off",
      "type": "OPERATION",
      "label": "Источник выключен — нет ответов",
      "x": 80.0,
      "y": 1580.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "operation": "value.set",
        "arguments": {
          "value": []
        },
        "resultVariable": "replyCandidates"
      }
    },
    {
      "id": "hint-replies",
      "type": "OPERATION",
      "label": "Найти ответы на похожие вопросы",
      "x": 500.0,
      "y": 1400.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "operation": "data.similarReplies",
        "arguments": {
          "text": "=var.sourceMessage.text",
          "excludeClientId": "=var.sourceMessage.clientId",
          "days": "=var.settings.days",
          "sameOrganizationOnly": "=var.settings.sameOrganization",
          "organizationId": "=var.sourceMessage.organizationId",
          "minAnswerLength": "=var.settings.minAnswer",
          "limit": "=var.settings.replies"
        },
        "resultVariable": "similarReplies"
      }
    },
    {
      "id": "hint-replies-candidates",
      "type": "OPERATION",
      "label": "Варианты: история чатов",
      "x": 920.0,
      "y": 1400.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "operation": "list.candidates",
        "arguments": {
          "items": "=var.similarReplies",
          "kind": "reply",
          "label": "'Ответ оператора на похожий вопрос другого клиента. ' + var.item.summary"
        },
        "resultVariable": "replyCandidates"
      }
    },
    {
      "id": "hint-merge-1",
      "type": "OPERATION",
      "label": "Объединить: статьи и заявки",
      "x": 1340.0,
      "y": 1400.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "operation": "list.concat",
        "arguments": {
          "first": "=var.articleCandidates",
          "second": "=var.taskCandidates"
        },
        "resultVariable": "someCandidates"
      }
    },
    {
      "id": "hint-merge-2",
      "type": "OPERATION",
      "label": "Объединить с историей чатов",
      "x": 1760.0,
      "y": 1400.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "operation": "list.concat",
        "arguments": {
          "first": "=var.someCandidates",
          "second": "=var.replyCandidates"
        },
        "resultVariable": "candidates"
      }
    },
    {
      "id": "hint-has-candidates",
      "type": "CONDITION",
      "label": "Есть из чего выбирать?",
      "x": 2180.0,
      "y": 1400.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "rule": {
          "left": "=var.candidates",
          "operator": "notEmpty"
        },
        "groups": [],
        "expression": "var.candidates.notEmpty()",
        "manualExpression": true
      }
    },
    {
      "id": "hint-end-3",
      "type": "END",
      "label": "На этом закончить",
      "x": 2180.0,
      "y": 1580.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "result": "Дополнительные действия не требуются"
      }
    },
    {
      "id": "hint-error-3",
      "type": "END",
      "label": "Ошибка — посмотреть журнал",
      "x": 2600.0,
      "y": 1580.0,
      "config": {
        "section": "3. Кандидаты из источников",
        "result": "Шаг не выполнен. Причина указана в журнале."
      }
    },
    {
      "id": "hint-decide",
      "type": "OPERATION",
      "label": "Выбрать лучший источник",
      "x": 80.0,
      "y": 1940.0,
      "config": {
        "section": "4. Выбор Jev",
        "operation": "ai.decide",
        "arguments": {
          "state": "=var.sourceMessage.text",
          "kind": "choice",
          "candidates": "=var.candidates",
          "labelField": "var.item.label",
          "question": "Что лучше всего поможет оператору ответить ТОЛЬКО на это последнее входящее сообщение клиента: статья базы знаний, закрытая заявка с той же проблемой или ответ оператора на похожий вопрос? Совпадения отдельных слов недостаточно: вариант должен быть о той же проблеме и содержать решение. Не продолжай старые темы. Если сообщение не содержит вопроса или проблемы, либо подходящего варианта нет, выбери «Ничего не подходит».",
          "options": {
            "__none__": "Ничего не подходит"
          },
          "yes": "Да",
          "no": "Нет"
        },
        "resultVariable": "decision"
      }
    },
    {
      "id": "hint-confident",
      "type": "CONDITION",
      "label": "Ответ получен и уверенности достаточно?",
      "x": 500.0,
      "y": 1940.0,
      "config": {
        "section": "4. Выбор Jev",
        "rule": {
          "all": [
            {
              "left": "=var.decision.available",
              "operator": "true"
            },
            {
              "left": "=var.decision.probability",
              "right": "=var.settings.threshold",
              "operator": ">="
            },
            {
              "left": "=var.decision.value",
              "operator": "notNull"
            }
          ]
        },
        "groups": [],
        "expression": "var.decision.available && var.decision.probability >= var.settings.threshold && var.decision.value.notNull()",
        "manualExpression": true
      }
    },
    {
      "id": "hint-end-4",
      "type": "END",
      "label": "На этом закончить",
      "x": 500.0,
      "y": 2120.0,
      "config": {
        "section": "4. Выбор Jev",
        "result": "Дополнительные действия не требуются"
      }
    },
    {
      "id": "hint-error-4",
      "type": "END",
      "label": "Ошибка — посмотреть журнал",
      "x": 80.0,
      "y": 2120.0,
      "config": {
        "section": "4. Выбор Jev",
        "result": "Шаг не выполнен. Причина указана в журнале."
      }
    },
    {
      "id": "hint-latest-announcement",
      "type": "OPERATION",
      "label": "Загрузить входящие сообщения клиента",
      "x": 80.0,
      "y": 2410.0,
      "config": {
        "section": "5. Защита от повторов",
        "operation": "data.messages",
        "arguments": {
          "limit": 1000,
          "clientId": "=var.sourceMessage.clientId",
          "incomingOnly": true,
          "newestFirstById": true
        },
        "resultVariable": "latestMessages"
      }
    },
    {
      "id": "hint-filter-announcement",
      "type": "OPERATION",
      "label": "Отобрать: latestIncoming",
      "x": 500.0,
      "y": 2410.0,
      "config": {
        "section": "5. Защита от повторов",
        "operation": "list.select",
        "arguments": {
          "items": "=var.latestMessages",
          "limit": 1,
          "where": "!var.item.sent && !var.item.comment && !var.item.system && !var.item.deleted",
          "sortBy": "id",
          "descending": true
        },
        "resultVariable": "latestIncoming"
      }
    },
    {
      "id": "hint-current-announcement",
      "type": "CONDITION",
      "label": "После выбора новых сообщений нет?",
      "x": 920.0,
      "y": 2410.0,
      "config": {
        "section": "5. Защита от повторов",
        "rule": {
          "left": "=var.latestIncoming.first().id",
          "right": "=var.sourceMessage.id",
          "operator": "="
        },
        "groups": [],
        "expression": "var.latestIncoming.first().id = var.sourceMessage.id",
        "manualExpression": true
      }
    },
    {
      "id": "hint-claim",
      "type": "OPERATION",
      "label": "Одна подсказка на сообщение",
      "x": 1340.0,
      "y": 2410.0,
      "config": {
        "section": "5. Защита от повторов",
        "operation": "state.claim",
        "arguments": {
          "key": "hint:client:{{ var.sourceMessage.clientId }}:message:{{ var.sourceMessage.id }}"
        },
        "resultVariable": "claim",
